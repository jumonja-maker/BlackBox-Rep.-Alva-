{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blackbox:findings:2",
  "title": "BLACK.BOX whole-interval findings (source integrity is not authenticity)",
  "type": "object",
  "required": [
    "schema_version",
    "engine",
    "file_trust",
    "root_cause",
    "findings",
    "findings_total",
    "analysis_limits"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "engine": {
      "const": "BLACKBOX_INVESTIGATION_2"
    },
    "file_trust": {
      "const": "UNVERIFIED_IMPORT"
    },
    "root_cause": {
      "const": "UNKNOWN"
    },
    "findings_total": {
      "type": "integer",
      "minimum": 0
    },
    "analysis_limits": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "schema_version",
          "code",
          "start_ns",
          "end_ns",
          "facts",
          "confidence_class",
          "hypotheses",
          "alternative_explanations",
          "limitations",
          "sources",
          "coverage",
          "root_cause"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "schema_version": {
            "const": 2
          },
          "code": {
            "type": "string"
          },
          "start_ns": {
            "type": "integer",
            "minimum": 0
          },
          "end_ns": {
            "type": [
              "integer",
              "null"
            ]
          },
          "confidence_class": {
            "enum": [
              "OBSERVED",
              "USER_REPORTED",
              "DERIVED",
              "UNAVAILABLE"
            ]
          },
          "facts": {
            "type": "array"
          },
          "hypotheses": {
            "type": "array"
          },
          "alternative_explanations": {
            "type": "array"
          },
          "limitations": {
            "type": "array"
          },
          "sources": {
            "type": "array"
          },
          "coverage": {
            "type": "object"
          },
          "root_cause": {
            "const": "UNKNOWN"
          },
          "root_cause_proven": {
            "const": false
          }
        }
      }
    }
  }
}
