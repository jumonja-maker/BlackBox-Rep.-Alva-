<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="BLACK.BOX owned CI QA">
  <Profiles>
    <SystemCollector Id="ScheduleCollector" Name="BLACKBOX schedule QA">
      <BufferSize Value="128" />
      <Buffers Value="256" />
    </SystemCollector>
    <SystemProvider Id="ScheduleProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="FileIO" />
        <Keyword Value="FileIOInit" />
        <Keyword Value="DiskIO" />
        <Keyword Value="DiskIOInit" />
      </Keywords>
      <Stacks><Stack Value="SampledProfile" /></Stacks>
    </SystemProvider>
    <Profile Id="BlackBoxSchedule.Verbose.Memory" Name="BlackBoxSchedule"
             Description="Bounded owned CI scheduler, sampled CPU and file observations"
             LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="ScheduleCollector">
          <SystemProviderId Value="ScheduleProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
